# Copy this file to .env and fill in real values. Never commit .env.

# --- Vision / embeddings ---
HF_API_TOKEN=

# --- LLM providers ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Vector store ---
COLLECTION_NAME=enterprise_knowledge
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# --- API security ---
# Comma-separated list of accepted keys, e.g. API_KEYS=key-one,key-two
# Generate strong random keys, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
REQUIRE_API_KEY=true

MAX_UPLOAD_MB=25
